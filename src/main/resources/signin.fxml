<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="689.0" prefWidth="938.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.SigninController">
   <children>
      <ImageView fitHeight="789.0" fitWidth="1158.0" layoutY="-2.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@bg.jpeg" />
         </image>
      </ImageView>
      <StackPane alignment="CENTER" layoutX="0" layoutY="0" prefHeight="689.0" prefWidth="938.0">
         <children>
            <VBox alignment="TOP_CENTER" maxWidth="400" spacing="20.0" styleClass="form-container" StackPane.alignment="CENTER">
               <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@nova_travel.png" />
                  </image>
                  <effect>
                     <Glow />
                  </effect>
               </ImageView>
               
               <Label styleClass="form-header" text="Connexion" />
               
               <VBox spacing="10.0" styleClass="input-container">
                  <TextField fx:id="email" promptText="Email" styleClass="text-field" />
                  <PasswordField fx:id="password" promptText="Mot de passe" styleClass="text-field" />
                  <Label fx:id="errorLabel" styleClass="error-message" visible="false" />
               </VBox>
               
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <CheckBox fx:id="rememberMe" styleClass="checkbox" text="Se souvenir de moi" />
               </HBox>
               
               <Button onAction="#login" styleClass="custom-button" text="Se Connecter" />
               
               <Hyperlink onAction="#goToSignup" styleClass="custom-link" text="Créer un compte" />
               <StackPane.margin>
                  <Insets left="100.0" />
               </StackPane.margin>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>
