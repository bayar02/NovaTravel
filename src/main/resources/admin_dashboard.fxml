<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="689.0" prefWidth="938.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AdminDashboardController">
    <VBox spacing="20" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="20">
            <Label text="Gestion des Utilisateurs" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Rechercher un utilisateur" prefWidth="200"/>
            <Button onAction="#handleSearch" text="Rechercher"/>
            <Button onAction="#handleLogout" text="Déconnexion" style="-fx-background-color: #ff760d; -fx-text-fill: white;"/>
        </HBox>
        
        <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="cinColumn" text="CIN" prefWidth="100"/>
                <TableColumn fx:id="nomColumn" text="Nom" prefWidth="100"/>
                <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="100"/>
                <TableColumn fx:id="telColumn" text="Téléphone" prefWidth="100"/>
                <TableColumn fx:id="mailColumn" text="Email" prefWidth="150"/>
                <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="100"/>
                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="150"/>
            </columns>
        </TableView>
        
        <HBox spacing="10" alignment="CENTER">
            <Button onAction="#handleAddUser" text="Ajouter un utilisateur" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</AnchorPane> 