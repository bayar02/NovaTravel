<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="495.0" prefWidth="808.0" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ShowPlanning">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER">
        <Text styleClass="view-header" text="Liste des Plannings" />
    </HBox>

    <!-- Formulaire de saisie -->
    <VBox spacing="15" styleClass="form-container" />

    <!-- Column Headers -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-font-weight: bold; -fx-padding: 5; -fx-background-color: #f0f0f0;">
        <Text text="Nom du Planning" wrappingWidth="150" />
        <Text text="Date de Création" wrappingWidth="150" />
        <Text text="Événements" wrappingWidth="250" />
    </HBox>

    <ListView fx:id="listPlanning" editable="true" onMouseClicked="#handlePlanningSelection" prefHeight="200.0" prefWidth="200.0" />

    <VBox layoutX="30.0" layoutY="82.0" prefHeight="148.0" prefWidth="725.0" spacing="15" styleClass="form-container">
      <children>
      
          <Button onAction="#goToUpdatePlanningPage" prefHeight="32.0" prefWidth="114.0" styleClass="button-primary">
              <graphic>
                  <HBox alignment="CENTER" spacing="5">
                      <Text fill="white" text="✏" />
                      <Text fill="white" text="Modifier" />
                  </HBox>
              </graphic>
          </Button>
      
                <Button onAction="#supprimerPlanning" prefHeight="32.0" prefWidth="116.0" styleClass="button-danger">
              <graphic>
                  <HBox alignment="CENTER" spacing="5">
                      <Text fill="white" text="🗑" />
                      <Text fill="white" text="Supprimer" />
                  </HBox>
              </graphic>
          </Button>
      
                <Button onAction="#handleClear" prefHeight="32.0" prefWidth="117.0" styleClass="button-primary">
              <graphic>
                  <HBox alignment="CENTER" spacing="5">
                      <Text fill="white" text="🔄" />
                      <Text fill="white" text="Réinitialiser" />
                  </HBox>
              </graphic>
          </Button>
      </children></VBox>
    <opaqueInsets>
        <Insets />
    </opaqueInsets>

</VBox>
