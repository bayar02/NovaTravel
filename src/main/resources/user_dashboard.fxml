        <Label style="-fx-font-size: 24px;" text="Bienvenue!" />
        <Button onAction="#handleLogout" style="-fx-background-color: #ff760d; -fx-text-fill: white;" text="Déconnexion" />
    </VBox>
</AnchorPane>
