<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="689.0" prefWidth="938.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.ShowPackController">
   <children>
      <ImageView fitHeight="789.0" fitWidth="1158.0" layoutY="-2.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@bg.jpeg" />
         </image>
      </ImageView>
      <VBox layoutX="0" layoutY="0" prefHeight="689.0" prefWidth="223.0" style="-fx-background-color: #ffffff;" styleClass="white-background" stylesheets="@style.css">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="150.0" prefWidth="223.0">
               <children>
                  <ImageView fitHeight="100.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@LOGO.png" />
                     </image>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </ImageView>
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#goBack" prefHeight="40.0" prefWidth="223.0" style="-fx-background-color: #ff760d;" text="Retour" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <VBox.margin>
                  <Insets left="20.0" right="20.0" top="20.0" />
               </VBox.margin>
            </Button>
         </children>
         <effect>
            <DropShadow />
         </effect>
      </VBox>
      <AnchorPane layoutX="223.0" layoutY="0.0" prefHeight="689.0" prefWidth="715.0">
         <children>
            <TableView fx:id="packTable" layoutX="50.0" layoutY="50.0" prefHeight="589.0" prefWidth="615.0" style="-fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 0, 0);">
               <columns>
                  <TableColumn fx:id="nomPackCol" prefWidth="120.0" text="Nom Pack" />
                  <TableColumn fx:id="descriptionCol" prefWidth="150.0" text="Description" />
                  <TableColumn fx:id="prixCol" prefWidth="80.0" text="Prix" />
                  <TableColumn fx:id="dureeCol" prefWidth="80.0" text="Durée" />
                  <TableColumn fx:id="avantagesCol" prefWidth="100.0" text="Avantages" />
                  <TableColumn fx:id="statutCol" prefWidth="80.0" text="Statut" />
               </columns>
            </TableView>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
