<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="700" prefWidth="940" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.UserProfileController">

    <stylesheets>
        <URL value="@../style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER">
        <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header" text="Modifier Profil" />
    </HBox>


    <!-- Form Inputs -->
    <VBox alignment="CENTER" prefHeight="382.0" prefWidth="899.0" spacing="15">
        <TextField fx:id="emailField" promptText="Email" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <PasswordField fx:id="passwordField" promptText="Mot de passe" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <TextField fx:id="nomField" promptText="Nom" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <TextField fx:id="prenomField" promptText="Prénom" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <TextField fx:id="cinField" promptText="CIN" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <TextField fx:id="telField" promptText="Téléphone" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
        <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" text="Erreur" visible="false" />
    </VBox>

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="saveButton" onAction="#handleSaveProfile" styleClass="primary-button" text="Enregistrer" />
        <Button fx:id="backButton" onAction="#handleBack" styleClass="danger-button" text="Annuler" />
    </HBox>

    <!-- Footer -->
    <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #34495E; -fx-padding: 20;">
        <Text style="-fx-text-fill: white; -fx-font-size: 16px;" />
    </HBox>
</VBox>
