<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AcceuilAdmin">
   <VBox layoutY="3.0">
      <children>

          <!-- Main Content Area -->
          <Pane fx:id="mainContent" prefHeight="594.0" prefWidth="800.0" style="-fx-background-color: #ECF0F1; -fx-border-color: #BDC3C7;">
            <VBox alignment="CENTER" layoutY="264.0" prefHeight="336.0" prefWidth="228.0" style="-fx-background-color: #34495E;">
               <children>
                    <Button fx:id="btnLogout" onAction="#logout" prefHeight="40" prefWidth="200" style="-fx-font-size: 14px; -fx-background-color: #E74C3C; -fx-text-fill: white;" text="Logout" />
               </children>
               <opaqueInsets>
                  <Insets bottom="50.0" top="50.0" />
               </opaqueInsets>
            </VBox>

              <!-- Welcome Message -->
              <VBox alignment="CENTER" layoutX="347.0" layoutY="203.0" prefHeight="150" prefWidth="400" spacing="10">

                  <Label fx:id="lblWelcome" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Welcome, Admin!" />
                  <Label fx:id="lblAdminEmail" style="-fx-font-size: 16px;" text="admin@example.com" />
              </VBox>
            <ImageView fitHeight="138.0" fitWidth="256.0" layoutX="419.0" layoutY="53.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../icons/LOGO.png" />
               </image>
            </ImageView>
            <VBox prefHeight="270.0" prefWidth="228.0" spacing="10.0" style="-fx-background-color: #34495E;">
               <children>
                    <Button fx:id="btnReclamation" onAction="#goToReclamations" prefHeight="40" prefWidth="200" style="-fx-font-size: 14px;" text="Gestion reclamations et Reponses" />
                    <Button fx:id="btnVols" onAction="#goToVols" prefHeight="40" prefWidth="200" style="-fx-font-size: 14px;" text="Gestion Vols" />
                    <Button fx:id="btnHebergements" onAction="#goToHebergements" prefHeight="40" prefWidth="200" style="-fx-font-size: 14px;" text="Gestion Hebergements" />
         
                    <Button fx:id="btnEvenements" onAction="#goToProfil" prefHeight="40" prefWidth="200" style="-fx-font-size: 14px;" text="Profil" />
                    <Button fx:id="btnUsers" onAction="#goToUsers" prefHeight="43.0" prefWidth="200.0" style="-fx-font-size: 14px;" text="Gestion Utilisateur" />
               </children>
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <padding>
                  <Insets bottom="10.0" left="10.0" top="10.0" />
               </padding>
            </VBox>
          </Pane>
      </children>
   </VBox>

</AnchorPane>
