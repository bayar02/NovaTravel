<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<VBox prefHeight="768" prefWidth="878.0" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.AdminDashboardController">

    <stylesheets>
        <URL value="@/style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <Button fx:id="backButton" text="← Back" onAction="#handleBack" />

    <!-- Navbar (if needed) -->

    <!-- Main Content -->
    <VBox prefWidth="986.0" spacing="20">
        <!-- Header -->
        <HBox alignment="CENTER">
            <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header" text="Gestion des Utilisateurs" />
        </HBox>

        <!-- Search Bar -->
        <HBox alignment="CENTER" spacing="15">
            <TextField fx:id="searchField" prefWidth="350" promptText="Rechercher un utilisateur" HBox.hgrow="ALWAYS">
                <HBox.margin>
                    <Insets right="10" />
                </HBox.margin>
            </TextField>
            <Button onAction="#handleSearch" styleClass="primary-button" text="Rechercher" />
            <Button onAction="#handleLogout" styleClass="danger-button" text="Déconnexion" />
        </HBox>

        <!-- Table Headers -->
        <HBox spacing="10" style="-fx-background-color: lightgray; -fx-padding: 5; -fx-font-weight: bold;">
            <Text text="Nom" wrappingWidth="100"/>
            <Text text="Prénom" wrappingWidth="100"/>
            <Text text="CIN" wrappingWidth="120"/>
            <Text text="Téléphone" wrappingWidth="120"/>
            <Text text="Email" wrappingWidth="200"/>
            <Text text="Rôle" wrappingWidth="120"/>
            <Text text="Actions" wrappingWidth="120"/>
        </HBox>

        <!-- Users List -->
        <ListView fx:id="userListView" prefHeight="400.0" prefWidth="855.0" VBox.vgrow="ALWAYS"/>

        <!-- Actions -->
        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#handleAddUser" styleClass="success-button" text="Ajouter un utilisateur" />
        </HBox>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #34495E; -fx-padding: 20;">
        <Text style="-fx-text-fill: white; -fx-font-size: 16px;" text="© 2025 Admin Dashboard" />
    </HBox>
</VBox>
