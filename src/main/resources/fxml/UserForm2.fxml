<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="700" prefWidth="940" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.UserFormController">

    <stylesheets>
        <URL value="@../style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Main Content -->
    <VBox spacing="20">
        <!-- Header -->
        <HBox alignment="CENTER">
            <Text style="-fx-font-size: 32px; -fx-font-weight: bold;" styleClass="view-header" text="Ajouter Utilisateur" />
        </HBox>

        <!-- Form Inputs -->
        <VBox alignment="CENTER" spacing="15">
            <TextField fx:id="cin" promptText="CIN" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
            <TextField fx:id="nom" promptText="Nom" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
            <TextField fx:id="prenom" promptText="Prénom" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
            <TextField fx:id="tel" promptText="Téléphone" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
            <TextField fx:id="mail" promptText="Email" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />
            <PasswordField fx:id="password" promptText="Mot de passe" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />

            <ChoiceBox fx:id="role" style="-fx-font-size: 14px; -fx-pref-width: 250px;" />

            <Label fx:id="errorLabel" style="-fx-text-fill: red; -fx-font-size: 12px;" text="Erreur" visible="false" />
        </VBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="save" onAction="#handleSave" styleClass="primary-button" text="Enregistrer" />
            <Button fx:id="cancel" onAction="#handleCancel" styleClass="danger-button" text="Annuler" />
        </HBox>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER" spacing="15" style="-fx-background-color: #34495E; -fx-padding: 20;">
        <Text style="-fx-text-fill: white; -fx-font-size: 16px;" text="© 2025 User Management" />
    </HBox>
</VBox>
