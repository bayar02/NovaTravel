<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="391.0" prefWidth="644.0" spacing="20" styleClass="content-container" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.WeatherController">

    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- En-tête -->
    <HBox alignment="CENTER">
        <Label styleClass="view-header" text="Météo Actuelle" />
    </HBox>

    <!-- Formulaire de recherche -->
    <HBox alignment="CENTER" spacing="10">
        <TextField fx:id="cityTextField" promptText="Entrez le nom de la ville" />
        <Button onAction="#showWeather" styleClass="button-primary" text="Chercher" />
    </HBox>

    <!-- Affichage des résultats -->
    <VBox fx:id="weatherContainer" alignment="CENTER" spacing="10">
        <Label fx:id="weatherLabel" prefHeight="218.0" prefWidth="284.0" styleClass="message-label" text="Les données météo s'afficheront ici." />
    </VBox>
</VBox>
